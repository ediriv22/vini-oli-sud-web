# Apache configuration for Vini Oli Sud on Aruba hosting
# Cache headers and security settings

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching — static assets (immutable)
<FilesMatch "\.(woff2?|ttf|otf|eot|js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
  Header set Content-Encoding gzip
</FilesMatch>

# Images cache
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
  Header set Cache-Control "public, max-age=2592000"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</FilesMatch>

# HTML pages — NON mettere in cache per un tempo lungo: i file JS/CSS
# hanno hash nel nome e sono cache "immutable" per 1 anno, e ogni deploy
# ELIMINA gli hash della build precedente. Se l'HTML resta in cache anche
# solo per un'ora, chi lo carica poco prima di un nuovo deploy si ritrova
# un HTML che punta a chunk JS ormai cancellati -> ChunkLoadError -> sito
# che sembra "crashare" (schermata bianca). Con max-age=0 il browser deve
# sempre rivalidare con il server prima di riusare la copia in cache.
<FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Content-Security-Policy: sito Next.js statico (export) + pannello /admin
  # in PHP con stili/script inline propri (editor visuale segreteria).
  # 'unsafe-inline' su script/style e' il compromesso: sia l'idratazione RSC
  # di Next (script inline nell'HTML) sia il pannello /admin (attributi
  # style="" e blocco <script> nella pagina) lo richiedono, e uno static
  # export non puo' generare nonce per-richiesta. Tutto il resto e' bloccato
  # a 'self': niente script/stili/immagini/font/richieste verso domini terzi,
  # niente plugin (object-src none), niente iframe/base/tag di terzi.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

# Rewrite rules for SPA routing (if needed)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Enable GZIP for SVG
AddType image/svg+xml svg svgz
AddEncoding gzip svgz

# Set proper charset
AddDefaultCharset UTF-8
